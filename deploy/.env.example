# Jingwei 1.1.0 Docker 部署配置
# 复制为 .env 后修改；.env 含密码，不要提交到 Git。

# 必填：PostgreSQL 密码，请使用强随机值。
# 密码会拼进数据库 DSN，建议只用字母和数字；含 @ : / 等字符时，
# 请自行 URL 编码后通过 ARTEX_PG_DSN 覆盖完整连接串。
POSTGRES_USER=jingwei
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=jingwei

# 可选：完整覆盖数据库连接串（容器内主机名为 postgres）
# ARTEX_PG_DSN=postgres://jingwei:change-me-please@postgres:5432/jingwei?sslmode=disable

# 镜像版本：升级时修改 tag，例如 1.0.0 → 1.1.0
JINGWEI_IMAGE=ghcr.io/domren/jingwei:1.1.0

# 宿主机端口
JINGWEI_WEB_PORT=9790
JINGWEI_PROXY_PORT=9791

# LLM：可在此填写，也可启动后进入「系统 → LLM」配置
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ARTEX_LLM_PROVIDER=
ARTEX_LLM_MODEL=
ARTEX_LLM_BASE_URL=
ARTEX_LLM_PROXY=
# 单次 LLM 调用的硬性墙钟（含 SDK 重试与流式读取），默认 15m。
# 模型网关变慢时可调小（如 300s），避免一次卡住的调用吃掉整个任务时长。
ARTEX_LLM_CALL_TIMEOUT=

# 可选：Java Chains 反序列化验证 sidecar（默认不启动）
# 启动：docker compose --profile java-chains up -d java-chains
JAVA_CHAINS_PASS=change-me-java-chains
JAVA_CHAINS_URL=http://java-chains:8011
# 由 java-chains-setup.sh 自动创建并写入；留空时 Skill 降级为 UI 自动化
JAVA_CHAINS_MCP_TOKEN=
JAVA_CHAINS_WEB_PORT=9792
# 回调端口默认只绑定本机；远端目标改为 0.0.0.0，用完立即恢复。
JAVA_CHAINS_CALLBACK_BIND=127.0.0.1
# 写入 payload、供目标回连的地址；目标在 Docker 网络内时可设为 java-chains。
JAVA_CHAINS_CALLBACK_HOST=127.0.0.1
# JAVA_CHAINS_IMAGE=javachains/javachains:2.0.0-beta7
