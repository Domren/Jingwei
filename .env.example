# Jingwei 独立部署配置（复制为 .env 后修改）
# 本二开工程使用本地构建镜像；如推送到了自己的仓库，可改为对应的镜像地址。
JINGWEI_IMAGE=jingwei:local
POSTGRES_USER=jingwei
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=jingwei

# 数据库连接串：留空则由上面三项拼装成容器内地址。
# 仅当口令含 @ : / 等需要 URL 编码的字符、或数据库不在这个 compose 里时才填写。
# 建议只使用字母和数字，此时保持留空即可。
JINGWEI_PG_DSN=

# LLM（二选一或都填；也可留空到 UI 里配）
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
JINGWEI_LLM_PROVIDER=
JINGWEI_LLM_MODEL=
JINGWEI_LLM_BASE_URL=
JINGWEI_LLM_PROXY=

# 可选：Java Chains 反序列化验证 sidecar（默认不启动）
# 启动：docker compose --profile java-chains up -d java-chains
# 必须设置登录密码；同一个值会注入 Jingwei 容器供 java-chains Skill 使用。
JAVA_CHAINS_PASS=change-me-java-chains
JAVA_CHAINS_URL=http://java-chains:8011
# MCP 令牌：sidecar 启动后执行 deploy/java-chains-setup.sh 自动创建并写入；
# 配置后 Skill 通过 MCP 调用生成/服务/任务能力，留空则降级为 UI 自动化。
JAVA_CHAINS_MCP_TOKEN=
JAVA_CHAINS_WEB_PORT=9792
# 宿主机在哪个网卡上发布回调端口（JNDI/LDAP/RMI/JRMP/FakeMySQL 等），默认只绑定本机。
# 目标在远端时改为 0.0.0.0 或指定网卡 IP，并限制防火墙；用完立即关闭。
# 回调端口没有认证，不能长期暴露公网。
JAVA_CHAINS_CALLBACK_BIND=127.0.0.1
# sidecar 容器内部的监听地址，保持 0.0.0.0：容器有独立网络命名空间，docker 把连接
# 转发到容器的 eth0 IP，绑 127.0.0.1 时宿主机端口虽开着、容器内却没人监听，
# 任何目标都回连不上（LDAP 侧表现为 anonymous bind failed）。
JAVA_CHAINS_LISTEN_BIND=0.0.0.0
# 写入 payload、供目标回连的地址。目标在 Docker 网络内时可设为 java-chains。
JAVA_CHAINS_CALLBACK_HOST=127.0.0.1
# JAVA_CHAINS_IMAGE=javachains/javachains:2.0.0-beta7

# ---- 运行时可调项（全部可留空，留空＝用代码内置默认值）----
# 内网隧道的控制端地址：必须是**目标机能访问到**的地址，裸主机名按 chisel 的 8788 处理。
# 不配它，深度利用里的隧道「自动选型」会直接返回未配置错误，chisel / ssh -R
# 两条自动生成部署命令的路都用不了。多机部署时这里是靶机可达的控制端 IP 或域名。
JINGWEI_PIVOT_SERVER=
# ssh -R 变体回连控制端的端口。chisel 用上面那个地址的端口，sshd 通常在 22，
# 两者不是一回事，所以分开配。留空＝22。
JINGWEI_PIVOT_SSH_PORT=
# ssh -R 登录控制端 sshd 用的用户名。留空＝用目标侧的登录名（两端同名才连得上，
# 不同名会在 BatchMode 下直接认证失败）。另外那一侧的 sshd 要把 GatewayPorts 设成
# clientspecified 或 yes，否则绑定 0.0.0.0 被拒：ssh 进程活着但控制端没有监听。
JINGWEI_PIVOT_SSH_USER=
# 可选：固定 chisel 控制端密钥指纹（43-44 位 base64，取自 chisel server 启动日志）。
# 留空＝不校验该条链路；填错会被拒绝生成命令。注意 chisel 没有 "auto" 这个值。
JINGWEI_PIVOT_CHISEL_FINGERPRINT=

# 监听端口：Web 界面与录制代理。录制代理只绑 127.0.0.1，公网请走反向代理。
JINGWEI_WEB_PORT=9790
JINGWEI_PROXY_PORT=9791

# 单次模型调用总墙钟（含 SDK 重试与流式读取），默认 15m。
# 网关变慢表现为「任务在跑、日志持续出现墙钟告警、漏洞数为 0」，此时调成 300s 让 worker 尽快放弃。
JINGWEI_LLM_CALL_TIMEOUT=
# 规划轮首帧超时（秒，纯数字或 90s 这种写法）：建连后这么久还不见第一个流事件就判
# stalled 并主动取消。默认 75s；中转端首帧常到 40–90s，频繁出现「首帧超时」时放宽到 120。
JINGWEI_LLM_FIRST_EVENT_TIMEOUT=
# false/0/off 关闭流式输出（默认流式）。
JINGWEI_LLM_STREAM=

# 范围管控强度：strict（默认，读不到范围/禁令即拒绝＝失败关闭）/ warn / off。
# 放宽是有意为之的操作：off 会让越界目标不再被拦，只在确认误伤且能承担后果时使用。
JINGWEI_GUARD_ENFORCEMENT=

# 落地物 TTL（小时）：WebShell 与内存马分开控制，未配用内置默认。
JINGWEI_WEBSHELL_TTL_HOURS=
JINGWEI_MEMSHELL_TTL_HOURS=

# 侧问（BTW）单次回答输出上限，仅接受 256–32768。
JINGWEI_BTW_MAX_OUTPUT_TOKENS=

# 抓包记录诊断：置 1 后每条完成流量都会打一行日志，用于定位「代理能转发但抓不到包」。
JINGWEI_TRAFFIC_DEBUG=

# JS 反混淆桥接脚本 / python 解释器 / 配置文件与 Skill 目录路径覆盖，一般留空。
JINGWEI_WEBCRACK_BRIDGE=
JINGWEI_WEBCRACK_PYTHON=
JINGWEI_CONFIG=
JINGWEI_SKILL_DIR=

# playwright 模块所在目录（浏览器真实验证 XSS 用）：镜像里已全局安装，通常留空。
# 只有模块被放到非常规位置（自建镜像、离线拷贝）时才需要填绝对路径。
JW_PLAYWRIGHT_MODULE=

# 仅本机开发（next dev 跨端口）需要时置 1：只对回环来源放行跨源；生产不要开。
JINGWEI_DEV_CORS=
